{
  "plugin_name": "SlidesConnect",
  "plugin_prefix": "GS",
  "resources_path": "Icons",
  "resx_path": "Properties/Resources.resx",

  "defaults": {
    "size": 24,
    "fg_color": "#FFFFFF",
    "background": {
      "shape": {
        "type": "rounded-square",
        "fill": "#FEBC12"
      }
    }
  },

  "plugin_icon": {
    "_note": "Superseded by a hand-designed asset — GS_Plugin_Icon_16px.png (plugin root) copied over Icons/GS_SlidesConnectLogo.png and re-embedded via add_to_resources. Do NOT run generate_plugin_icon again without first re-copying that file back in, or it will regenerate from the fields below and overwrite the custom icon.",
    "size": 16,
    "resource_name": "SlidesConnectLogo",
    "fg_iconify_id": "mynaui:presentation-solid",
    "fg_color": "#FFFFFF",
    "background": {
      "shape": { "type": "circle", "fill": "#FEBC12" }
    }
  },

  "subcategories": {
    "Auth":         { "fg_color": "#FFFFFF", "background": { "shape": { "type": "circle",            "fill": "#FEBC12" } } },
    "Presentation": { "fg_color": "#FFFFFF", "background": { "shape": { "type": "document",          "fill": "#FEBC12" } } },
    "Slides":       { "fg_color": "#FFFFFF", "background": { "shape": { "type": "rounded-square",    "fill": "#FEBC12" } } },
    "Layouts":      { "fg_color": "#FFFFFF", "background": { "shape": { "type": "rounded-rectangle", "fill": "#FEBC12" } } },
    "Shapes":       { "fg_color": "#FFFFFF", "background": { "shape": { "type": "block",             "fill": "#FEBC12" } } },
    "Text":         { "fg_color": "#FFFFFF", "background": { "shape": { "type": "bubble",             "fill": "#FEBC12" } } },
    "TextStyle":    { "fg_color": "#FFFFFF", "background": { "shape": { "type": "hexagon",           "fill": "#FEBC12" } } },
    "Tables":       { "fg_color": "#FFFFFF", "background": { "shape": { "type": "cut-square",        "fill": "#FEBC12" } } },
    "Insert":       { "fg_color": "#FFFFFF", "background": { "shape": { "type": "file",              "fill": "#FEBC12" } } },
    "Aggregate":    { "fg_color": "#FFFFFF", "background": { "shape": { "type": "arrow-square",      "fill": "#FEBC12" } } },
    "Presets":      { "fg_color": "#FFFFFF", "background": { "shape": { "type": "bookmark",          "fill": "#FEBC12" } } }
